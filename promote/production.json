{
  "targets": [
    {
      "name": "claude-plugins",
      "repo": "MGT-Insurance/claude-plugins",
      "exclude": [
        "chatgpt/",
        ".agents/",
        "shared/",
        "scripts/",
        ".github/workflows/promote.yml",
        "promote/"
      ],
      "replacements": [
        { "from": "MGT-Insurance/agentic-plugins-main", "to": "MGT-Insurance/claude-plugins" },
        { "from": "mgt-insurance-main", "to": "mgt-insurance" },
        { "from": "mcp-main.mgtinsurance.ai", "to": "mcp.mgtinsurance.ai" },
        { "from": "HgnEBwza09kAszhdXtoEnz6ofrCHrM2v", "to": "uMMqJMAYSADCF3BY9yJqHlzpb1tbNV17" },
        { "from": "MGT Quoting (main)", "to": "MGT Quoting" }
      ],
      "forbid": ["-main", "(main)", "HgnEBwza09kAszhdXtoEnz6ofrCHrM2v"],
      "notice": {
        "file": "promote/production-notice.md",
        "prependTo": ["README.md", "CLAUDE.md"]
      }
    },
    {
      "name": "chatgpt-plugins",
      "repo": "MGT-Insurance/chatgpt-plugins",
      "include": ["chatgpt/", ".agents/"],
      "replacements": [
        { "from": "MGT-Insurance/agentic-plugins-main", "to": "MGT-Insurance/chatgpt-plugins" },
        { "from": "mgt-insurance-chatgpt-main", "to": "mgt-insurance-chatgpt" },
        { "from": "mgt-quoting-main", "to": "mgt-quoting" },
        { "from": "mcp-main.mgtinsurance.ai", "to": "mcp.mgtinsurance.ai" },
        { "from": "mgt-dev.us.auth0.com", "to": "mgtinsurance.us.auth0.com" },
        { "from": "CHATGPT_DEV_CLIENT_ID_PLACEHOLDER", "to": "CHATGPT_PROD_CLIENT_ID_PLACEHOLDER" },
        { "from": "MGT Quoting (main)", "to": "MGT Quoting" },
        { "from": "MGT Insurance (main)", "to": "MGT Insurance" }
      ],
      "forbid": ["-main", "(main)", "mgt-dev", "CHATGPT_DEV_CLIENT_ID_PLACEHOLDER"],
      "zip": { "source": "chatgpt/mgt-quoting", "output": "mgt-quoting.zip" }
    }
  ]
}
